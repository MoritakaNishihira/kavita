{
  // compose.yaml / docker-compose.yml / Caddyfile を正しい言語モードで開く
  "files.associations": {
    "compose.yaml": "yaml",
    "compose.yml": "yaml",
    "docker-compose.yaml": "yaml",
    "docker-compose.yml": "yaml",
    "*.env": "dotenv",
    "Caddyfile": "caddyfile",
    "Caddyfile.*": "caddyfile"
  },

  // Docker Compose のスキーマを適用して補完・検証を効かせる
  "yaml.schemas": {
    "https://raw.githubusercontent.com/compose-spec/compose-spec/master/schema/compose-spec.json": [
      "compose.yaml",
      "compose.yml",
      "docker-compose.yaml",
      "docker-compose.yml"
    ]
  },

  // 保存時に自動整形
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,

  // YAML はスペース2つ・タブ禁止が一般的
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    }
  },

  // Caddyfile はタブ幅を見やすく
  "[caddyfile]": {
    "editor.tabSize": 2,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true
  },

  // matthewpi.caddyfile-support の自動整形には caddy 実行ファイルが必要(caddy v2.2.0+)
  // Docker内のcaddyしかない場合は空のままでOK(整形はスキップされる)。
  // ホスト側に caddy をインストール済みならパスを指定してください。
  // 例(Linux/macOS): "/usr/bin/caddy"  例(Windows): "C:\\caddy\\caddy.exe"
  "caddyfile.executable": "",

  // Docker Desktop / エンジンなしでも docker compose の構文チェックを有効化
  "docker.dockerComposeDetectionPaths": [
    "compose.yaml",
    "compose.yml",
    "docker-compose.yaml",
    "docker-compose.yml"
  ],

  // 保存時に行末の空白を削除・改行を統一(設定ファイルの事故防止)
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n"
}
